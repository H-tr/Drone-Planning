<?xml version="1.0" ?>
<robot name="drone">
  <!-- The collision model of drone.urdf, the source of the VAMP model
       (cricket, scripts/generate_fk.sh drone), generated by
       scripts/spherize_robot.sh drone: foam's medial fit of the body
       box (9 spheres), each grown by 3.8 mm, the largest distance of a
       box point outside foam's spheres (3.73 mm) rounded up; then one
       sphere at the gimbal pivot that holds the camera at every pan and
       tilt (87.8 mm). Every sphere is on base_link, so the gimbal
       angles do not change whether the drone collides. -->
  <link name="world" />
  <joint name="base_x_joint" type="prismatic">
    <parent link="world" />
    <child link="base_x_link" />
    <axis xyz="1 0 0" />
    <limit lower="-10" upper="10" effort="0" velocity="0" />
  </joint>
  <link name="base_x_link" />
  <joint name="base_y_joint" type="prismatic">
    <parent link="base_x_link" />
    <child link="base_y_link" />
    <axis xyz="0 1 0" />
    <limit lower="-10" upper="10" effort="0" velocity="0" />
  </joint>
  <link name="base_y_link" />
  <joint name="base_z_joint" type="prismatic">
    <parent link="base_y_link" />
    <child link="base_z_link" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="10" effort="0" velocity="0" />
  </joint>
  <link name="base_z_link" />
  <joint name="base_yaw_joint" type="revolute">
    <parent link="base_z_link" />
    <child link="base_link" />
    <axis xyz="0 0 1" />
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="0" velocity="0" />
  </joint>
  <link name="base_link">
    <collision>
      <origin xyz="-0.163933 0.161097 0.000000" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.116600" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.155558 0.160996 0.000001" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.121712" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.006587 0.161147 0.000010" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.129786" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.150841 0.013792 -0.000004" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.124327" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.169164 -0.146881 0.000000" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.123265" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.018668 -0.155640 -0.000001" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.131404" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.149995 -0.163411 0.000000" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.124007" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.169972 -0.005049 0.000001" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.124667" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.031583 0.012311 0.000005" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.130708" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.000000 0.000000 -0.060000" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.087800" />
      </geometry>
    </collision>
  </link>
  <joint name="camera_pan" type="revolute">
    <origin xyz="0 0 -0.06" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="gimbal" />
    <axis xyz="0 0 1" />
    <limit lower="-1.5707963267948966" upper="1.5707963267948966" effort="0" velocity="0" />
  </joint>
  <link name="gimbal" />
  <joint name="camera_tilt" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="gimbal" />
    <child link="camera" />
    <axis xyz="0 -1 0" />
    <limit lower="-1.5707963267948966" upper="0.5235987755982988" effort="0" velocity="0" />
  </joint>
  <link name="camera" />
</robot>
