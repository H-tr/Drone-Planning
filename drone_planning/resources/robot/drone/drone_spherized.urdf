<?xml version="1.0" ?>
<robot name="drone">
  <!-- The collision model of drone.urdf, the source of the VAMP model
       (cricket, scripts/generate_fk.sh drone).  Written by hand, not by
       foam: the collision geometry of drone.urdf already is one sphere
       (radius 0.30 m at the centre of base_link), so this file keeps the
       joints and that sphere, without the visual boxes.  The gimbal links
       have no collision geometry. -->
  <link name="world" />
  <joint name="base_x_joint" type="prismatic">
    <parent link="world" />
    <child link="base_x_link" />
    <axis xyz="1 0 0" />
    <limit lower="-10" upper="10" effort="0" velocity="0" />
  </joint>
  <link name="base_x_link" />
  <joint name="base_y_joint" type="prismatic">
    <parent link="base_x_link" />
    <child link="base_y_link" />
    <axis xyz="0 1 0" />
    <limit lower="-10" upper="10" effort="0" velocity="0" />
  </joint>
  <link name="base_y_link" />
  <joint name="base_z_joint" type="prismatic">
    <parent link="base_y_link" />
    <child link="base_z_link" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="10" effort="0" velocity="0" />
  </joint>
  <link name="base_z_link" />
  <joint name="base_yaw_joint" type="revolute">
    <parent link="base_z_link" />
    <child link="base_link" />
    <axis xyz="0 0 1" />
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="0" velocity="0" />
  </joint>
  <link name="base_link">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.30" />
      </geometry>
    </collision>
  </link>
  <joint name="camera_pan" type="revolute">
    <origin xyz="0 0 -0.06" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="gimbal" />
    <axis xyz="0 0 1" />
    <limit lower="-1.5707963267948966" upper="1.5707963267948966" effort="0" velocity="0" />
  </joint>
  <link name="gimbal" />
  <joint name="camera_tilt" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="gimbal" />
    <child link="camera" />
    <axis xyz="0 -1 0" />
    <limit lower="-1.5707963267948966" upper="0.5235987755982988" effort="0" velocity="0" />
  </joint>
  <link name="camera" />
</robot>
